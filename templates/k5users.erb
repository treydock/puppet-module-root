<%- scope['root::kerberos_users_commands'].each_pair do |user, commands| -%>
<%-
  commands = commands.join(' ') if commands.is_a?(Array)
  commands_str = commands.to_s.strip
-%>
<%= user %><%= " #{commands_str}" unless commands_str.empty? %>
<%- end -%>
